<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0d1117">

    <!-- 顶部控制栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#161b22">

        <!-- 服务器地址输入 -->
        <EditText
            android:id="@+id/serverEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Windows Tailscale 地址（如 http://100.x.x.x:8000）"
            android:inputType="textUri"
            android:textSize="13sp"
            android:padding="10dp"
            android:background="#21262d"
            android:textColor="#e6edf3"
            android:textColorHint="#8b949e"
            android:singleLine="true"
            android:layout_marginBottom="8dp" />

        <!-- Token输入 -->
        <EditText
            android:id="@+id/tokenEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入6位Token"
            android:inputType="text"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="#21262d"
            android:textColor="#e6edf3"
            android:textColorHint="#8b949e"
            android:maxLength="6"
            android:layout_marginBottom="10dp" />

        <!-- 连接按钮 -->
        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="连接"
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:backgroundTint="#238636" />

        <!-- 状态显示 -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="就绪"
            android:textSize="12sp"
            android:textColor="#8b949e"
            android:gravity="center"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- 视频显示区域 -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

</LinearLayout>
